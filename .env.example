# === Приложение ===
APP_NAME="Виртуальный продуктовый комитет"
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# === База данных ===
# dev: sqlite, prod: postgresql+asyncpg://vpc:vpc@db:5432/vpc
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# === JWT (в production: >= 32 случайных символов!) ===
JWT_SECRET=dev-secret-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# === LLM ===
# auto | ollama | huggingface
LLM_ENGINE=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
HF_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# === RAG (эта часть — за Колей) ===
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=decision_memory
RETRIEVAL_TOP_K=5
RRF_K=60

# === Инфраструктура ===
REDIS_URL=redis://localhost:6379/0
EVAL_MODE=full
